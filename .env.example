# === Anthropic API (Phase 2 AI agents) ===
# Create a key at https://console.anthropic.com
# IMPORTANT: set a $5/month spend limit in Console -> Settings -> Limits.
ANTHROPIC_API_KEY=

# === Email briefing (optional) ===
# For Gmail, create an "App Password" (Google Account -> Security -> App passwords).
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_TO=

# === Holdings auto-sync via SnapTrade (optional) ===
# Connects your Robinhood account so the briefing pulls live holdings + real cost basis
# instead of you hand-editing config/positions.yaml. Set the first two from your SnapTrade
# app, then run `python -m src.link_broker` once to fill in the user values.
# Leave these blank to keep using positions.yaml as before.
SNAPTRADE_CLIENT_ID=
SNAPTRADE_CONSUMER_KEY=
SNAPTRADE_USER_ID=stock-advisor
SNAPTRADE_USER_SECRET=
# SNAPTRADE_ACCOUNT_ID=          # optional: pin one account; omit to aggregate all
